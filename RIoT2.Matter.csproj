<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.14</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RIoT2.Matter.Tests" />
    <Compile Remove="ControlBridge\**" />
    <Compile Remove="Controller\**" />
    <Compile Remove="OnOffSample\**" />
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <EmbeddedResource Remove="ControlBridge\**" />
    <EmbeddedResource Remove="Controller\**" />
    <EmbeddedResource Remove="OnOffSample\**" />
    <None Remove="ControlBridge\**" />
    <None Remove="Controller\**" />
    <None Remove="OnOffSample\**" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="Scalar.AspNetCore" Version="2.0.7" />
		<PackageReference Include="QRCoder" Version="1.6.0" />
		<!-- CMS SignedData, used to build the Certification Declaration in TestAttestationFactory. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.0" />
	</ItemGroup>

	<!-- The fixed CHIP test PAA / CD-signing material TestAttestationFactory mints TEST chains from. -->
	<ItemGroup>
		<EmbeddedResource Include="Credentials\Certificates\*.pem">
			<LogicalName>RIoT2.Matter.Credentials.Certificates.%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
	</ItemGroup>
</Project>